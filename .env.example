# Optional: point the Systems button at the separately deployed application.
# Defaults to the local /systems page when omitted.
NEXT_PUBLIC_SYSTEMS_APP_URL=

# Optional Google OAuth. Configure both credentials and an exact callback URL
# in the Google Cloud OAuth client before enabling Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
AUTH_SESSION_SECRET=

# Optional secret for signing admin API session cookies.
ADMIN_SESSION_SECRET=
